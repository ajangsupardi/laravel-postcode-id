{
    "name": "ajangsupardi/laravel-postcode-id",
    "description": "Laravel package for seeding Indonesian address data (provinces, regencies, districts, villages) with postal codes from Pos Indonesia",
    "type": "library",
    "keywords": ["laravel", "postcode", "indonesia", "postal-code", "address", "database-seeder"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ajang Supardi",
            "email": "ajangsupardi@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ajangsupardi\\PostcodeId\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ajangsupardi\\PostcodeId\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ajangsupardi\\PostcodeId\\PostcodeIdServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
